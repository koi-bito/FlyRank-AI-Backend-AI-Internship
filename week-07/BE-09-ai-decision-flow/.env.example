# Optional AI API Key (OpenRouter Free Tier or OpenAI)
# If left empty, system operates in deterministic zero-cost offline mode.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Alternative: local Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
# Inngest Dev Server Port
INNGEST_DEV_SERVER_PORT=8288
PORT=8000
